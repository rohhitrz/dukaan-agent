# Copy to .env and fill in
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
# Reasoning models refuse function tools in chat/completions unless this is "none".
OPENAI_REASONING_EFFORT=none

# Agent loop safety net: max LLM round-trips per user turn
MAX_TOOL_ITERATIONS=6

# DEBUG prints the full loop (messages, tool calls, raw args) to stdout
LOG_LEVEL=INFO

# --- Phase 1: tracing ---
# Self-hosted Langfuse from docker-compose.yml. These keys are created by the
# LANGFUSE_INIT_* block in that file on first startup - local throwaway values.
LANGFUSE_PUBLIC_KEY=pk-lf-dukaan-local
LANGFUSE_SECRET_KEY=sk-lf-dukaan-local
LANGFUSE_HOST=http://localhost:3100
# Langfuse filters by environment and groups by release.
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=phase-1

# USD per 1M tokens. Leave at 0 while Langfuse computes cost from its own model
# table; set them if the cost column comes back empty for this model.
PRICE_PER_1M_INPUT=0
PRICE_PER_1M_OUTPUT=0
